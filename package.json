{
  "name": "flexi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "test:backend": "node --experimental-strip-types --test tests/backend/*.test.ts",
    "test:database": "node scripts/test-database.mjs",
    "test:database:native": "node scripts/test-database-native.mjs",
    "smoke:api": "node --env-file=.env.local --env-file=.env.smoke scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "html-react-parser": "^5.2.10",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@11.25.0"
}
